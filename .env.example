# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key. Safe to expose to a browser — RLS protects the data behind it.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Password used for the two throwaway RLS test users.
TEST_USER_PASSWORD=change-me

# Service-role key. NEVER expose this client-side or commit real values here.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- engine only (engine/app/config.py requires all four) ---

# Secret the engine verifies user JWTs against.
# Supabase dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Shared secret proving a caller is the Next.js BFF rather than an arbitrary
# client holding a stolen user JWT. Self-generated; any long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_SHARED_TOKEN=generate-a-long-random-string
GEMINI_API_KEY=enter your api key