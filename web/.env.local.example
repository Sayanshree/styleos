# Copy to web/.env.local and fill in real values.
# web/.env.local is gitignored by the root .gitignore (`.env*.local`).

# --- public: inlined into the browser bundle ---

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key. Safe in a browser: row level security is what protects
# the data behind it (supabase/migrations/0002_rls_policies.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- server-only: no NEXT_PUBLIC_ prefix, never reaches the browser ---

# Shared secret proving to the engine that a caller is this BFF rather than an
# arbitrary client holding a stolen user JWT. Must match SERVICE_SHARED_TOKEN in
# the engine's environment exactly.
SERVICE_SHARED_TOKEN=must-match-the-engine

# Base URL of the FastAPI engine. Server-side only; never exposed to the browser.
ENGINE_URL=http://127.0.0.1:8000

# NOTE: the Supabase service-role / secret key does NOT belong in this file or
# anywhere else under web/. It bypasses row level security entirely and is used
# only by the engine. If you find yourself adding it here, something is wrong.
